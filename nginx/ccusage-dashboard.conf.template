# Template. bin/install-nginx.sh fills in the repo path and the listen port,
# writing nginx/ccusage-dashboard.conf (gitignored). Do not edit the rendered file.
server {
    listen __PORT__;
    listen [::]:__PORT__;
    server_name _;
    root __ROOT__/www;
    index index.html;
    access_log /var/log/nginx/ccusage-dashboard.access.log;
    error_log  /var/log/nginx/ccusage-dashboard.error.log;

    gzip on;
    gzip_types application/json text/css application/javascript;
    gzip_min_length 1024;

    location = /healthz { return 200 "ok\n"; add_header Content-Type text/plain; }

    location /data/ {
        add_header Cache-Control "no-store";
        types { application/json json; }
    }
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }
}
